              en_balance = Number(engine.balance);
            }
            
            var state = GameSettingsStore.getState(en_balance);
            state.isConnected = Engine.isConnected;
            state.showMessage = true;
            state.isMobileOrSmall = Clib.isMobileOrSmall(); //bool
            return state;
        },

